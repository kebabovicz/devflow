#!/bin/bash
# devflow — the engine's command line.
#
# Every subcommand answers with a return code first and machine-readable output
# second: a consumer reads the code and the JSON, never the prose. Free-text
# parsing is how a UI and an engine drift apart.
#
# Return codes (fixed across every subcommand):
#   0  done
#   1  bad invocation — unknown subcommand, missing or unreadable path
#   2  environment not ready — no manifest where one is required
#   3  condition not met — a gate refused (blocked ticket, missing approval)
#   4  state conflict — someone else holds what was asked for
#
# Requires: bash, jq, git.

set -u

SELF_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../lib/devflow-lib.sh
. "$SELF_DIR/../lib/devflow-lib.sh"

usage() {
  cat <<'USAGE'
devflow — engine commands for devflow-managed repositories

  devflow status [--json] [path ...]
      Report the state of each path: whether devflow is set up there, the
      branch checked out, its maps, tickets by status, and open questions.
      Reads only — no file is written. Defaults to the current directory.

      A path without .devflow is not an error: it is reported with
      "engine": false. A path that is not a git repository is reported with
      "branch": null. Only an unreadable path returns a non-zero code.

  devflow ticket take <ref> [--owner <name>] [--json]
      Claim a ticket for this session and mark it in progress. The claim is
      atomic: of several sessions asking at once, exactly one succeeds and the
      rest are told who holds it.

      Refuses (code 3) when the ticket is not open, when its contract is not
      approved, when a blocker is not done, or when it carries an unanswered
      question. Refuses (code 4) when someone already holds it. The session
      limit is not checked here: it belongs to `ticket start`, which dispatches
      several at once.

  devflow contract draft <ref> [--delivers <md|->] [--acceptance <md|->] [--json]
      Write the ticket's contract — what it delivers and how anyone will know it
      is done — and mark it a draft awaiting a person. Either flag reads stdin
      with `-`; only one of them may. With neither, the sections already in the
      ticket are checked and marked as they stand.

      Refuses (code 3) when the result would say nothing about delivery or carry
      no acceptance criterion: a contract with no way to tell it is fulfilled is
      not a contract. Drafting over an approved contract returns it to draft —
      editing what was agreed withdraws the agreement.

  devflow contract approve <ref> [--by <name>] [--json]
      Approve a drafted contract, recording when and by whom. This is the user's
      act: a session may draft a contract and propose it, never approve its own.
      Refuses (code 3) when there is no contract to approve.

  devflow ticket release <ref> [--json]
      Drop the claim. Does not touch Status: the lock says who is holding the
      work, the status says what state the work is in, and releasing a claim
      after a session died must not rewrite the second. Releasing a ticket that
      nobody holds succeeds and reports released: false.

  devflow question add <ticket> --text <markdown|-> [--json]
      Attach a question to a ticket and block it until someone answers. `-`
      reads the body from stdin, so a multi-line question survives the shell.
      The status the ticket had is recorded on the question and restored when
      it is settled. Refuses (code 3) on a finished ticket: it waits on nobody.

  devflow question answer <ticket> --text <markdown|-> [--question Q2] [--json]
  devflow question drop <ticket> [--question Q2] [--json]
      Settle a question — by answering it, or by taking it back. Without
      --question the oldest open one is used. The body stays either way: the
      trail of what was decided is why the entries are kept. The ticket leaves
      `blocked` only when nothing else on it still waits on a person.

  devflow help
      This text.

Return codes: 0 done · 1 bad invocation · 2 environment not ready ·
3 condition not met · 4 state conflict.
USAGE
}

# ── status ───────────────────────────────────────────────────────────────────
#
# The shape below is the API the pult reads. Keys are never omitted: an unknown
# value is null, so a consumer can tell "not applicable" from "not collected".
# "schema" is bumped whenever a key changes meaning.

cmd_status() {
  local json=0 paths=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow status: unknown option %s\n' "$1" >&2; return 1 ;;
      *) paths+=("$1"); shift ;;
    esac
  done
  [ "${#paths[@]}" -eq 0 ] && paths=(".")

  local repos_json="[]" p abs
  for p in "${paths[@]}"; do
    if [ ! -d "$p" ]; then
      printf 'devflow status: no such directory: %s\n' "$p" >&2
      return 1
    fi
    abs=$(cd "$p" 2>/dev/null && pwd) || {
      printf 'devflow status: cannot read: %s\n' "$p" >&2
      return 1
    }
    repos_json=$(printf '%s' "$repos_json" \
      | jq --argjson r "$(status_repo "$abs")" '. + [$r]')
  done

  local out
  out=$(jq -n --argjson repos "$repos_json" \
    '{schema: 1, generated_at: (now | todateiso8601), repos: $repos}')

  if [ "$json" -eq 1 ]; then
    printf '%s\n' "$out"
  else
    status_human "$out"
  fi
  return 0
}

# One repository, as JSON. Never fails: an absent engine, an absent git repo and
# an empty map are all states worth reporting, not errors.
status_repo() {
  local dir="$1" manifest maps_root maps_dir maps_path
  local engine=false branch_json=null name

  name=$(basename "$dir")
  manifest="$dir/.devflow/project.yml"
  [ -f "$manifest" ] && engine=true

  if df_is_git "$dir"; then
    local b; b=$(df_branch "$dir")
    [ -n "$b" ] && branch_json=$(printf '%s' "$b" | jq -Rs 'rtrimstr("\n")')
  fi

  local maps_json="[]"
  if [ "$engine" = true ]; then
    maps_root=$(df_maps_root "$dir")
    maps_dir=$(df_maps_dir "$manifest")
    maps_path="$maps_root/$maps_dir"
    if [ -d "$maps_path" ]; then
      local d
      for d in "$maps_path"/*/; do
        [ -d "$d" ] || continue
        maps_json=$(printf '%s' "$maps_json" \
          | jq --argjson m "$(status_map "$d")" '. + [$m]')
      done
    fi
  fi

  jq -n \
    --arg path "$dir" \
    --arg name "$name" \
    --argjson engine "$engine" \
    --argjson branch "$branch_json" \
    --argjson maps "$maps_json" \
    '{
       path: $path,
       name: $name,
       engine: $engine,
       branch: $branch,
       maps: $maps,
       counts: ($maps | map(.counts) | reduce .[] as $c ({}; . as $acc
                 | reduce ($c | keys_unsorted[]) as $k ($acc;
                     .[$k] = ((.[$k] // 0) + $c[$k])))),
       tickets_total: ($maps | map(.tickets | length) | add // 0),
       questions_open: ($maps | map(.questions_open) | add // 0),
       sessions: []
     }'
}

# One map directory. A map with no tickets is a real state — charting stops at
# decisions sometimes — so it is reported with an empty list, not skipped.
status_map() {
  local d="${1%/}" slug
  slug=$(basename "$d")

  local tickets_json="[]" f
  if [ -d "$d/tickets" ]; then
    for f in "$d/tickets"/*.md; do
      [ -f "$f" ] || continue
      tickets_json=$(printf '%s' "$tickets_json" \
        | jq --argjson t "$(status_ticket "$f")" '. + [$t]')
    done
  fi

  # Questions are decision tickets under issues/: `Status: open | claimed |
  # resolved`. Open and claimed both still wait on a human.
  local q_open=0
  if [ -d "$d/issues" ]; then
    for f in "$d/issues"/*.md; do
      [ -f "$f" ] || continue
      local s; s=$(df_header "$f" "Status") || s=""
      case "$s" in open|claimed) q_open=$((q_open + 1)) ;; esac
    done
  fi

  jq -n \
    --arg slug "$slug" \
    --arg path "$d" \
    --argjson tickets "$tickets_json" \
    --argjson q "$q_open" \
    '{
       slug: $slug,
       path: $path,
       tickets: $tickets,
       questions_open: $q,
       counts: ($tickets | group_by(.status)
                 | map({key: .[0].status, value: length}) | from_entries)
     }'
}

# One ticket file. `status_raw` is what the file says; `status` is the
# normalized bucket. Both are reported because the two have drifted and a
# consumer needs to show one while counting the other.
status_ticket() {
  local f="$1" id raw blocked title
  id=$(basename "$f" .md)
  raw=$(df_header "$f" "Status") || raw=""
  blocked=$(df_header "$f" "Blocked by") || blocked=""
  title=$(df_title "$f") || title=""

  local blocked_json="[]"
  case "$(printf '%s' "$blocked" | tr '[:upper:]' '[:lower:]')" in
    ""|none) ;;
    *) blocked_json=$(printf '%s' "$blocked" \
         | jq -Rs 'split(",") | map(gsub("^\\s+|\\s+$"; "")) | map(select(length > 0))') ;;
  esac

  # Acceptance criteria are a checklist under `## Acceptance`; ticked boxes are
  # what the implementer claims, never what a verification run confirmed.
  local acc_total=0 acc_done=0
  if grep -qE '^## Acceptance' "$f" 2>/dev/null; then
    local section
    section=$(sed -n '/^## Acceptance/,/^## /p' "$f" 2>/dev/null)
    acc_total=$(printf '%s' "$section" | grep -cE '^[[:space:]]*- \[.\]' || true)
    acc_done=$(printf '%s' "$section" | grep -cE '^[[:space:]]*- \[[xX]\]' || true)
  fi

  # Who holds the ticket, if anyone. This is what lets the tree show a session
  # against the work it is doing — the reason claims exist at all.
  local lock lock_json=null
  lock=$(df_lock_dir "$f")
  if [ -d "$lock" ]; then
    local held since pid alive=false
    held=$(cat "$lock/owner" 2>/dev/null || echo unknown)
    since=$(cat "$lock/since" 2>/dev/null || echo unknown)
    pid=$(cat "$lock/pid" 2>/dev/null || echo "")
    df_pid_alive "$pid" && alive=true
    lock_json=$(jq -n --arg o "$held" --arg s "$since" --argjson a "$alive" \
      '{owner: $o, since: $s, holder_pid_alive: $a, stale: ($a | not)}')
  fi

  jq -n \
    --arg id "$id" \
    --arg path "$f" \
    --arg title "$title" \
    --arg raw "$raw" \
    --arg norm "$(df_status_norm "$raw")" \
    --argjson blocked "$blocked_json" \
    --argjson acc_total "${acc_total:-0}" \
    --argjson acc_done "${acc_done:-0}" \
    --argjson lock "$lock_json" \
    --arg c_state "$(df_contract_state "$f")" \
    --arg c_at "$(df_contract_meta "$f" at)" \
    --arg c_by "$(df_contract_meta "$f" by)" \
    '{
       id: $id,
       path: $path,
       title: (if $title == "" then null else $title end),
       status: (if $norm == "" then null else $norm end),
       status_raw: (if $raw == "" then null else $raw end),
       blocked_by: $blocked,
       acceptance: {total: $acc_total, checked: $acc_done},
       contract: {
         state: $c_state,
         at: (if $c_at == "" then null else $c_at end),
         by: (if $c_by == "" then null else $c_by end)
       },
       lock: $lock,
       session: null
     }'
}

# Human view. One line per repository, same facts as the JSON — a person
# checking the engine should not have to read JSON to do it.
status_human() {
  printf '%s' "$1" | jq -r '
    .repos[] |
    (.name) as $n |
    (if .engine then
       ((.counts | to_entries | map("\(.key)=\(.value)") | join(" "))
        | if . == "" then "тикетов нет" else . end)
     else "движок не заведён" end) as $t |
    (.branch // "не git-репозиторий") as $b |
    (if .questions_open > 0 then " · вопросов: \(.questions_open)" else "" end) as $q |
    ([.maps[]?.tickets[]? | select(.contract.state == "draft")] | length) as $d |
    (if $d > 0 then " · контрактов на одобрение: \($d)" else "" end) as $c |
    "\($n)  [\($b)]  \($t)\($q)\($c)"
  '
}

# ── ticket ───────────────────────────────────────────────────────────────────

# Emit a result object and exit. Every outcome — success, refusal, conflict —
# leaves the same shape behind, so a consumer reads `ok` and `reason` instead of
# matching on prose. `reason` is a stable slug; `message` is for a person.
ticket_result() { # $1=code $2=reason-slug $3=message $4=extra-json
  local code="$1" reason="$2" msg="$3" extra="${4:-}"
  [ -n "$extra" ] || extra='{}'
  jq -n --argjson code "$code" --arg reason "$reason" --arg message "$msg" \
        --argjson extra "$extra" \
    '{ok: ($code == 0), code: $code, reason: $reason, message: $message} + $extra'
  exit "$code"
}

# The two resolvers below set a global instead of printing their answer. A
# refusal has to end the whole command, and `exit` inside a command
# substitution only ends the subshell it runs in — the caller would carry on
# with the refusal JSON in a variable. Globals keep the refusal fatal.

DF_MAPS=""    # maps directory for the current project
DF_TICKET=""  # resolved ticket file

# Locate the maps directory for the current directory, or refuse.
ticket_context() {
  local dir manifest
  dir=$(pwd)
  manifest="$dir/.devflow/project.yml"
  if [ ! -f "$manifest" ]; then
    ticket_result 2 not_onboarded \
      "devflow is not set up here — no .devflow/project.yml. Run /devflow:init first."
  fi
  DF_MAPS="$(df_maps_root "$dir")/$(df_maps_dir "$manifest")"
}

# Resolve a reference to exactly one ticket, or refuse with what was found.
ticket_resolve() { # $1=ref
  local matches n
  matches=$(df_find_ticket "$DF_MAPS" "$1")
  n=$(printf '%s' "$matches" | grep -c . || true)
  if [ "${n:-0}" -eq 0 ]; then
    ticket_result 1 not_found "no ticket matches '$1'"
  fi
  if [ "${n:-0}" -gt 1 ]; then
    ticket_result 1 ambiguous "'$1' matches $n tickets — name one exactly" \
      "$(printf '%s' "$matches" | jq -Rs 'split("\n") | map(select(length>0)) | {candidates: .}')"
  fi
  DF_TICKET="$matches"
}

# Someone else holds it. Reports who, since when, and whether the pid recorded
# in the lock is still alive — a hint that the holder died, never a verdict:
# breaking the claim is `ticket release`, a decision for the caller.
ticket_take_conflict() { # $1=ticket-id $2=lock dir
  local held since alive=false
  held=$(cat "$2/owner" 2>/dev/null || echo unknown)
  since=$(cat "$2/since" 2>/dev/null || echo unknown)
  df_pid_alive "$(cat "$2/pid" 2>/dev/null || true)" && alive=true
  ticket_result 4 already_held "$1 is held by $held since $since" \
    "$(jq -n --arg h "$held" --arg s "$since" --argjson a "$alive" \
       '{holder: $h, since: $s, holder_pid_alive: $a, stale: ($a | not)}')"
}

cmd_ticket_take() {
  local ref="" owner="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --owner) owner="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow ticket take: unknown option %s\n' "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow ticket take: which ticket?\n' >&2; return 1; }
  [ -n "$owner" ] || owner="$(hostname -s 2>/dev/null || echo host):$PPID"

  local maps file id
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)

  # ── held already? Checked first because a taken ticket is also `in progress`,
  # and "someone holds it" is the more useful answer than "it is not open" —
  # different code, different fix. This is a courtesy, not the guarantee: the
  # lock could appear a microsecond from now, and the mkdir below is what
  # actually decides the race.
  local lock; lock=$(df_lock_dir "$file")
  if [ -d "$lock" ]; then
    ticket_take_conflict "$id" "$lock"
  fi

  # ── takeable? The three conditions the skills already state in prose.
  local raw norm
  raw=$(df_header "$file" "Status") || raw=""
  norm=$(df_status_norm "$raw")
  if [ "$norm" != "open" ]; then
    # `in progress` with no lock is the legacy state: a skill set the status by
    # hand before claims existed. Name it, rather than quietly claiming over it.
    if [ "$norm" = "in progress" ] && [ ! -d "$(df_lock_dir "$file")" ]; then
      ticket_result 3 in_progress_unlocked \
        "$id is marked in progress but nobody holds a claim — a session set it by hand. Release is not needed; decide whether that work is still live."
    fi
    ticket_result 3 not_open "$id is '$raw', not open"
  fi

  # ── agreed? Work does not start on a ticket nobody signed off. The check sits
  # after the status gate on purpose: for a `done` ticket "it is not open" is the
  # more useful answer than "its contract is a draft". A ticket cut before
  # contracts had a name passes — it was reviewed when it was sliced, and
  # refusing every existing ticket would make this gate a migration, not a rule.
  local contract; contract=$(df_contract_state "$file")
  case "$contract" in
    approved|legacy) ;;
    draft)
      ticket_result 3 contract_unapproved \
        "the contract for $id is a draft — a person approves it with 'devflow contract approve $id' before work starts" \
        "$(jq -n '{contract: "draft"}')" ;;
    none)
      ticket_result 3 contract_unapproved \
        "$id has no contract — it does not say what it delivers or how anyone would know it is done. Draft one with 'devflow contract draft $id'" \
        "$(jq -n '{contract: "none"}')" ;;
    *)
      ticket_result 3 contract_unapproved \
        "the contract for $id reads '$contract', which is not an approval" \
        "$(jq -n --arg c "$contract" '{contract: $c}')" ;;
  esac

  local blocked blocker bfile bstatus unmet=""
  blocked=$(df_header "$file" "Blocked by") || blocked=""
  case "$(printf '%s' "$blocked" | tr '[:upper:]' '[:lower:]')" in ""|none) ;; *)
    for blocker in $(printf '%s' "$blocked" | tr ',' ' '); do
      bfile=$(df_find_ticket "$(dirname "$(dirname "$file")")" "$blocker" | head -1)
      [ -n "$bfile" ] || bfile=$(df_find_ticket "$maps" "$blocker" | head -1)
      if [ -z "$bfile" ]; then unmet="$unmet $blocker(unknown)"; continue; fi
      bstatus=$(df_status_norm "$(df_header "$bfile" "Status")")
      [ "$bstatus" = "done" ] || unmet="$unmet $blocker($bstatus)"
    done ;;
  esac
  if [ -n "$unmet" ]; then
    ticket_result 3 blocked_by "$id is blocked by:${unmet}" \
      "$(printf '%s' "${unmet# }" | jq -Rs 'split(" ") | map(select(length>0)) | {blockers: .}')"
  fi

  # An unanswered question makes a ticket un-takeable — an earlier ticket left it
  # there precisely so nobody would answer it here. Answered and dropped ones do
  # not count: they are history, and a ticket whose questions were all settled is
  # ready again.
  local n_open
  n_open=$(df_questions_open "$file")
  if [ "${n_open:-0}" -gt 0 ]; then
    ticket_result 3 open_questions \
      "$id carries $n_open unanswered question(s) — answer with 'devflow question answer' before taking it" \
      "$(jq -n --argjson n "${n_open:-0}" '{questions_open: $n}')"
  fi

  # ── the claim. mkdir either creates the directory or fails; there is no
  # window between checking and creating, which is the whole point. Two sessions
  # reaching this line together both call mkdir; the kernel picks one.
  mkdir -p "$(dirname "$lock")" 2>/dev/null
  if ! mkdir "$lock" 2>/dev/null; then
    ticket_take_conflict "$id" "$lock"
  fi

  printf '%s\n' "$owner" > "$lock/owner"
  date -u +%Y-%m-%dT%H:%M:%SZ > "$lock/since"
  printf '%s\n' "$PPID" > "$lock/pid"

  # Status second: the claim is what makes this exclusive, the status is what
  # the stop gate and the loop read. A claim without the status would be a
  # half-take, so undo it rather than leave one behind.
  if ! df_set_header "$file" "Status" "in progress"; then
    rm -rf "$lock"
    ticket_result 2 write_failed "could not write $file — claim released"
  fi

  ticket_result 0 taken "$id taken by $owner" \
    "$(jq -n --arg id "$id" --arg p "$file" --arg o "$owner" \
       '{ticket: $id, path: $p, owner: $o, status: "in progress"}')"
}

cmd_ticket_release() {
  local ref="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow ticket release: unknown option %s\n' "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow ticket release: which ticket?\n' >&2; return 1; }

  local maps file id lock
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)
  lock=$(df_lock_dir "$file")

  if [ ! -d "$lock" ]; then
    ticket_result 0 not_held "$id is not held by anyone" '{"released": false}'
  fi
  local held; held=$(cat "$lock/owner" 2>/dev/null || echo unknown)
  rm -rf "$lock"
  ticket_result 0 released "claim on $id released (was $held)" \
    "$(jq -n --arg h "$held" '{released: true, was_held_by: $h}')"
}

# ── question ─────────────────────────────────────────────────────────────────
#
# A question belongs to a ticket. There is no such thing as a free-floating one:
# the ticket is what the answer changes, and a question nobody can attach to
# work is a note, not a decision waiting on a person.
#
# Asking blocks the ticket and records the status it had, so answering restores
# that state rather than guessing. Answered and dropped questions stay in the
# file — the trail of what was decided is the reason to keep them.

# Read a body from --text: a literal string, or stdin when it is `-`.
question_body() { # $1=raw --text value
  if [ "$1" = "-" ]; then cat; else printf '%s' "$1"; fi
}

question_section() { # $1=ticket file  -> current body on stdout
  df_section_body "$1" "Open questions" 2>/dev/null | sed -e '/./,$!d'
}

cmd_question_add() {
  local ref="" text="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --text) text="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow question add: unknown option %s\n' "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow question add: which ticket?\n' >&2; return 1; }
  [ -n "$text" ] || { printf 'devflow question add: --text is required\n' >&2; return 1; }

  local maps file id
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)

  local raw norm
  raw=$(df_header "$file" "Status") || raw=""
  norm=$(df_status_norm "$raw")
  case "$norm" in
    done|cancelled)
      ticket_result 3 not_live \
        "$id is '$raw' — a finished ticket does not wait on anyone" ;;
  esac

  local body n now tmp
  body=$(question_body "$text")
  [ -n "$body" ] || { printf 'devflow question add: the question is empty\n' >&2; return 1; }
  n=$(df_next_question_n "$file")
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)

  # The status recorded on the heading is what answering restores. Written
  # before the status changes, or `blocked` would record itself.
  tmp=$(mktemp) || return 1
  question_section "$file" > "$tmp"
  if [ -s "$tmp" ]; then printf '\n' >> "$tmp"; fi
  printf '### Q%s · open · asked %s · was: %s\n\n' "$n" "$now" "$norm" >> "$tmp"
  printf '%s\n' "$body" >> "$tmp"

  if ! df_section_replace "$file" "Open questions" "$tmp"; then
    rm -f "$tmp"
    ticket_result 2 write_failed "could not write $file"
  fi
  rm -f "$tmp"

  if [ "$norm" != "blocked" ]; then
    df_set_header "$file" "Status" "blocked" || true
  fi

  ticket_result 0 asked "Q$n added to $id — ticket is blocked until it is answered" \
    "$(jq -n --arg id "$id" --arg q "Q$n" --arg was "$norm" --arg p "$file" \
       '{ticket: $id, question: $q, was: $was, path: $p, status: "blocked"}')"
}

# Close one question, by answering it or by dropping it. Both keep the body and
# both restore the ticket's status when nothing else is left open — the only
# difference is what the heading records and whether an answer is written.
question_close() { # $1=mode(answer|drop) $2..=args
  local mode="$1"; shift
  local ref="" qref="" text="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --text) text="${2:-}"; shift 2 ;;
      --question) qref="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow question %s: unknown option %s\n' "$mode" "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow question %s: which ticket?\n' "$mode" >&2; return 1; }
  if [ "$mode" = answer ] && [ -z "$text" ]; then
    printf 'devflow question answer: --text is required\n' >&2; return 1
  fi

  local maps file id
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)

  local section target was
  section=$(question_section "$file")
  # Which question: the one named, else the oldest still open.
  if [ -n "$qref" ]; then
    target=$(printf '%s' "$qref" | sed -E 's/^[Qq]//')
    printf '%s\n' "$section" | grep -qE "^### Q$target · open" || \
      ticket_result 1 no_such_question "Q$target is not open on $id"
  else
    target=$(printf '%s\n' "$section" | sed -nE 's/^### Q([0-9]+) · open.*/\1/p' | head -1)
    [ -n "$target" ] || ticket_result 3 nothing_open "$id has no open question"
  fi
  was=$(printf '%s\n' "$section" | sed -nE "s/^### Q$target · open.*was: (.*)\$/\1/p" | head -1)

  local now tmp ansfile=""
  now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if [ "$mode" = answer ]; then
    ansfile=$(mktemp) || return 1
    question_body "$text" > "$ansfile"
    [ -s "$ansfile" ] || { rm -f "$ansfile"; printf 'devflow question answer: the answer is empty\n' >&2; return 1; }
  fi

  # One pass: rewrite the heading's state, and for an answer append the body at
  # the end of that question's block — before the next heading, or at the end of
  # the section when it is the last one. The answer is read from a file so a
  # multi-line markdown body survives intact.
  tmp=$(mktemp) || { rm -f "$ansfile"; return 1; }
  printf '%s\n' "$section" | awk -v q="$target" -v mode="$mode" -v now="$now" \
      -v ansfile="$ansfile" '
    function flush_answer() {
      if (mode == "answer" && inside) {
        print ""; print "**Answer:**";  print "";
        while ((getline line < ansfile) > 0) print line;
        close(ansfile);
      }
      inside = 0
    }
    $0 ~ ("^### Q" q " · open") {
      asked = $0; sub(/^.*· asked /, "", asked); sub(/ ·.*$/, "", asked);
      printf "### Q%s · %s %s · asked %s\n", q, (mode == "answer" ? "answered" : "dropped"), now, asked;
      inside = 1; next
    }
    /^### Q/ { flush_answer(); print; next }
    { print }
    END { flush_answer() }
  ' > "$tmp"
  rm -f "$ansfile"

  if ! df_section_replace "$file" "Open questions" "$tmp"; then
    rm -f "$tmp"; ticket_result 2 write_failed "could not write $file"
  fi
  rm -f "$tmp"

  # Restore only when nothing else waits on a person.
  local still restored=null
  still=$(df_questions_open "$file")
  if [ "${still:-0}" -eq 0 ]; then
    local back="$was"
    if [ -z "$back" ] || [ "$back" = "blocked" ]; then back="open"; fi
    df_set_header "$file" "Status" "$back" || true
    restored=$(printf '%s' "$back" | jq -Rs 'rtrimstr("\n")')
  fi

  local verb=answered; [ "$mode" = drop ] && verb=dropped
  ticket_result 0 "$verb" "Q$target on $id $verb" \
    "$(jq -n --arg id "$id" --arg q "Q$target" --argjson still "${still:-0}" \
            --argjson restored "$restored" \
       '{ticket: $id, question: $q, still_open: $still, status: $restored}')"
}

# ── contract ─────────────────────────────────────────────────────────────────
#
# The contract is not a new document. A ticket already states what it delivers
# and what has to be true for it to be done; that pair *is* the contract, and a
# `## Contract` section beside them would only say the same thing twice. What
# was missing is the state: whether a person has looked at those two sections
# and agreed that finishing them finishes the work.

# Read a flag body: `-` takes stdin, so a multi-line markdown block survives the
# shell. Only one flag per call may read stdin — the second would get nothing
# and silently write an empty section.
contract_body() { # $1=raw flag value
  if [ "$1" = "-" ]; then cat; else printf '%s' "$1"; fi
}

cmd_contract_draft() {
  local ref="" delivers="" acceptance="" has_d=0 has_a=0 json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --delivers) delivers="${2:-}"; has_d=1; shift 2 ;;
      --acceptance) acceptance="${2:-}"; has_a=1; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow contract draft: unknown option %s\n' "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow contract draft: which ticket?\n' >&2; return 1; }
  if [ "$delivers" = "-" ] && [ "$acceptance" = "-" ]; then
    printf 'devflow contract draft: only one of --delivers and --acceptance can read stdin\n' >&2
    return 1
  fi

  local maps file id
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)

  local raw norm was
  raw=$(df_header "$file" "Status") || raw=""
  norm=$(df_status_norm "$raw")
  case "$norm" in
    done|cancelled)
      ticket_result 3 not_live \
        "$id is '$raw' — a finished ticket is past the point of agreeing what it delivers" ;;
  esac
  was=$(df_contract_state "$file")

  # Validate before writing. The alternative — write, then check what came out —
  # leaves a half-written contract behind on every refusal.
  local d_body="" a_body=""
  [ "$has_d" -eq 1 ] && d_body=$(contract_body "$delivers")
  [ "$has_a" -eq 1 ] && a_body=$(contract_body "$acceptance")

  local will_deliver will_accept
  if [ "$has_d" -eq 1 ]; then
    will_deliver=$(printf '%s' "$d_body" | tr -d '[:space:]')
  else
    will_deliver=$(df_section_body "$file" "What it delivers" 2>/dev/null | tr -d '[:space:]')
  fi
  if [ -z "$will_deliver" ]; then
    ticket_result 3 contract_incomplete \
      "$id does not say what it delivers — pass --delivers or fill '## What it delivers'"
  fi

  if [ "$has_a" -eq 1 ]; then
    will_accept=$(printf '%s\n' "$a_body" | grep -cE '^[[:space:]]*- \[.\]') || will_accept=0
  else
    will_accept=$(df_section_body "$file" "Acceptance" 2>/dev/null \
                  | grep -cE '^[[:space:]]*- \[.\]') || will_accept=0
  fi
  if [ "${will_accept:-0}" -eq 0 ]; then
    ticket_result 3 contract_incomplete \
      "$id carries no acceptance criterion — a contract nobody can check is not a contract. Criteria are a checklist: '- [ ] <mechanically checkable>'"
  fi

  local tmp
  if [ "$has_d" -eq 1 ]; then
    tmp=$(mktemp) || return 1
    printf '%s\n' "$d_body" > "$tmp"
    if ! df_section_replace "$file" "What it delivers" "$tmp"; then
      rm -f "$tmp"; ticket_result 2 write_failed "could not write $file"
    fi
    rm -f "$tmp"
  fi
  if [ "$has_a" -eq 1 ]; then
    tmp=$(mktemp) || return 1
    printf '%s\n' "$a_body" > "$tmp"
    if ! df_section_replace "$file" "Acceptance" "$tmp"; then
      rm -f "$tmp"; ticket_result 2 write_failed "could not write $file"
    fi
    rm -f "$tmp"
  fi

  if ! df_set_header "$file" "Contract" "draft"; then
    ticket_result 2 write_failed "could not write $file"
  fi

  local note=""
  [ "$was" = "approved" ] && note=" — the earlier approval is withdrawn, the contract changed"
  ticket_result 0 drafted "contract for $id is a draft awaiting approval$note" \
    "$(jq -n --arg id "$id" --arg p "$file" --arg was "$was" \
       '{ticket: $id, path: $p, contract: "draft", was: $was}')"
}

cmd_contract_approve() {
  local ref="" by="" json=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --by) by="${2:-}"; shift 2 ;;
      --json) json=1; shift ;;
      -h|--help) usage; return 0 ;;
      -*) printf 'devflow contract approve: unknown option %s\n' "$1" >&2; return 1 ;;
      *) ref="$1"; shift ;;
    esac
  done
  [ -n "$ref" ] || { printf 'devflow contract approve: which ticket?\n' >&2; return 1; }
  [ -n "$by" ] || by="$(hostname -s 2>/dev/null || echo host):$(id -un 2>/dev/null || echo user)"

  local maps file id
  ticket_context; maps="$DF_MAPS"
  ticket_resolve "$ref"; file="$DF_TICKET"
  id=$(basename "$file" .md)

  local state; state=$(df_contract_state "$file")
  if [ "$state" = "none" ]; then
    ticket_result 3 no_contract \
      "$id has no contract to approve — draft one with 'devflow contract draft $id'"
  fi
  if [ "$state" = "approved" ]; then
    ticket_result 0 already_approved "contract for $id was already approved" \
      "$(jq -n --arg id "$id" --arg p "$file" \
            --arg at "$(df_contract_meta "$file" at)" \
            --arg by "$(df_contract_meta "$file" by)" \
         '{ticket: $id, path: $p, contract: "approved", at: $at, by: $by}')"
  fi

  local now; now=$(date -u +%Y-%m-%dT%H:%M:%SZ)
  if ! df_set_header "$file" "Contract" "approved $now by $by"; then
    ticket_result 2 write_failed "could not write $file"
  fi

  ticket_result 0 approved "contract for $id approved by $by — it can be taken into work" \
    "$(jq -n --arg id "$id" --arg p "$file" --arg at "$now" --arg by "$by" --arg was "$state" \
       '{ticket: $id, path: $p, contract: "approved", at: $at, by: $by, was: $was}')"
}

cmd_contract() {
  case "${1:-}" in
    draft) shift; cmd_contract_draft "$@" ;;
    approve) shift; cmd_contract_approve "$@" ;;
    -h|--help|"") usage ;;
    *) printf 'devflow contract: unknown subcommand: %s\n' "$1" >&2; return 1 ;;
  esac
}

cmd_question() {
  case "${1:-}" in
    add) shift; cmd_question_add "$@" ;;
    answer) shift; question_close answer "$@" ;;
    drop) shift; question_close drop "$@" ;;
    -h|--help|"") usage ;;
    *) printf 'devflow question: unknown subcommand: %s\n' "$1" >&2; return 1 ;;
  esac
}

cmd_ticket() {
  case "${1:-}" in
    take) shift; cmd_ticket_take "$@" ;;
    release) shift; cmd_ticket_release "$@" ;;
    -h|--help|"") usage ;;
    *) printf 'devflow ticket: unknown subcommand: %s\n' "$1" >&2; return 1 ;;
  esac
}

# ── dispatch ─────────────────────────────────────────────────────────────────

command -v jq >/dev/null 2>&1 || {
  printf 'devflow: jq is required\n' >&2
  exit 2
}

case "${1:-}" in
  status) shift; cmd_status "$@" ;;
  ticket) shift; cmd_ticket "$@" ;;
  contract) shift; cmd_contract "$@" ;;
  question) shift; cmd_question "$@" ;;
  help|-h|--help|"") usage ;;
  *) printf 'devflow: unknown command: %s\n\n' "$1" >&2; usage >&2; exit 1 ;;
esac
